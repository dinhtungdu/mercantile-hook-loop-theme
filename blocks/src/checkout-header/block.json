{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mercantile/checkout-header",
	"version": "1.0.0",
	"title": "Checkout Header",
	"category": "theme",
	"description": "Checkout crumb, trust meta, and step navigation for the checkout template.",
	"icon": "cart",
	"textdomain": "mercantile-hook-loop",
	"attributes": {
		"current": {
			"type": "string",
			"default": "checkout",
			"enum": [ "cart", "checkout", "confirm" ]
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true,
		"multiple": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
