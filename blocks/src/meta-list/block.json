{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mercantile/meta-list",
	"version": "1.0.0",
	"title": "Meta List",
	"category": "theme",
	"description": "Two-column list of label/value rows separated by a dashed rule. Used for spec rows in the hero rail. Items live as block attributes, edited from the inspector.",
	"icon": "list-view",
	"textdomain": "mercantile-hook-loop",
	"attributes": {
		"items": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true,
		"color": {
			"background": true,
			"text": true,
			"link": false
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"__experimentalDefaultControls": { "padding": true }
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": { "fontSize": true }
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
